# AI 配置（兼容 OPENAI_*，代码优先读取 AI_*）
AI_API_KEY=your-openai-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 数据库配置（使用 SQLite）
DATABASE_URL=sqlite+aiosqlite:////data/newssys-pro.db
DATABASE_TYPE=sqlite
DATABASE_NAME=newssys-pro

# 环境配置
ENVIRONMENT=production
LOG_LEVEL=INFO
ENABLE_SCHEDULER=false
SERVICE_MAX_UPTIME_SECONDS=86400
SERVICE_HEALTHCHECK_INTERVAL_SECONDS=30
SERVICE_HEALTHCHECK_GRACE_SECONDS=60
SERVICE_HEALTHCHECK_FAILURES=3
SCHEDULER_HEARTBEAT_FILE=/tmp/newssys-scheduler-heartbeat
SCHEDULER_HEARTBEAT_STALE_SECONDS=90
REPORT_HEARTBEAT_FILE=/tmp/newssys-report-heartbeat
REPORT_HEARTBEAT_STALE_SECONDS=90
CRAWL_HEARTBEAT_FILE=/tmp/newssys-crawl-heartbeat
CRAWL_HEARTBEAT_STALE_SECONDS=90
SEARCH_HEARTBEAT_FILE=/tmp/newssys-search-heartbeat
SEARCH_HEARTBEAT_STALE_SECONDS=90
AI_HEARTBEAT_FILE=/tmp/newssys-ai-heartbeat
AI_HEARTBEAT_STALE_SECONDS=90

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# 前端地址
FRONTEND_URL=http://localhost:3000
